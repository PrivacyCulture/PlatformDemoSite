{
	"name": "videoai",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate": "tsx scripts/generate.ts",
		"stitch": "tsx scripts/stitch.ts",
		"encode:scrub": "tsx scripts/encode-scrub.ts",
		"lint:types": "tsc -p tsconfig.tools.json --noEmit"
	},
	"dependencies": {
		"@fontsource/poppins": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"dotenv": "16.6.1",
		"replicate": "1.4.0",
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "24.0.13",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "4.20.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
