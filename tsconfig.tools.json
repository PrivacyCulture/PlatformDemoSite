{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "dist-tools"
	},
	"include": ["scripts/**/*.ts", "tools/**/*.ts"]
}
