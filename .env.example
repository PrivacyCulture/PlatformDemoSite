REPLICATE_API_TOKEN=your_token_here

# Replicate model version string, e.g. "stability-ai/stable-video-diffusion:3f0457..." or similar.
# You MUST set this to a model that outputs an MP4 (or a URL to one).
REPLICATE_MODEL=

# HubSpot Meetings Scheduler (book-a-demo)
# Private app token with: scheduler.meetings.meeting-link.read, crm.objects.contacts.read, crm.objects.contacts.write
# Leave empty to borrow Sorted's HubSpot connection via SORTED_API_URL + CONTENT_API_TOKEN.
HUBSPOT_ACCESS_TOKEN=
# The path from your meetings link, owner included:
# meetings-eu1.hubspot.com/jane-doe/discovery-call → jane-doe/discovery-call
HUBSPOT_MEETING_SLUG=

# Optional SLA owner IDs (HubSpot owner ids). Defaults are placeholders in hubspotProperties.ts.
HUBSPOT_OWNER_PRIORITY=
HUBSPOT_OWNER_MIDMARKET=
HUBSPOT_OWNER_ENTERPRISE=
HUBSPOT_OWNER_NURTURE=
HUBSPOT_OWNER_SMB=

# Site content (CMS). Leave CONTENT_API_URL / CONTENT_API_TOKEN unset to run
# entirely from data/database.json.
# Base URL of the Sorted CMS (no trailing slash needed).
# CONTENT_API_URL=https://sorted.example.com
# Shared secret: sent as a Bearer token to the CMS, and required on
# POST /api/content/refresh when the CMS pings this site.
# CONTENT_API_TOKEN=
# live (published content, the default) or draft (the preview service).
# CONTENT_CHANNEL=live
# Seconds before content is re-checked. Defaults: 300 live, 5 draft.
# CONTENT_CACHE_SECONDS=
# Public URL of this site. Required by adapter-node now pages render per request.
# ORIGIN=https://www.example.com

# Base URL of Sorted, used to borrow its HubSpot token for the book-a-demo form.
# Separate from CONTENT_API_URL so this does not also switch the content source.
# SORTED_API_URL=https://sorted.privacyculture.com
